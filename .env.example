# Copy to .env at the project root. .env is gitignored — never commit real values.

# --- LinkedIn session (required) ----------------------------------------------
# From an authenticated linkedin.com browser session:
#   DevTools > Application > Cookies > https://www.linkedin.com
# Use a burner account: automated collection can get an account restricted.
LI_AT=
# Copy the JSESSIONID value INCLUDING its surrounding double quotes, e.g.
#   LI_JSESSIONID="ajax:1234567890123456789"
# The csrf-token header is derived from this by stripping the quotes; if the two
# disagree LinkedIn answers 403 "CSRF check failed".
LI_JSESSIONID=

# --- Our API ------------------------------------------------------------------
# Shared secret callers send as the X-API-Key header. Leave blank to disable the
# check (fine locally, unwise on a public URL — a stranger burns your LinkedIn
# rate limit, not theirs).
API_KEY=

# --- Politeness knobs (optional; defaults are deliberately conservative) ------
# CACHE_TTL_SECONDS=21600     # 6h. Repeat lookups never touch LinkedIn.
# MIN_REQUEST_INTERVAL=3.0    # Seconds between upstream calls, plus jitter.
# DAILY_FETCH_BUDGET=300      # Profiles per UTC day before we start refusing.
# REQUEST_TIMEOUT=20.0
# LI_LANG=en_US

# --- Volatile LinkedIn strings (override without a code change) ---------------
# LI_PROFILE_DECORATION=com.linkedin.voyager.dash.deco.identity.profile.FullProfileWithEntities-93
